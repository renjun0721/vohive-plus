#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=14

start_service() {
    [ -x /usr/local/bin/vohive-frpc ] || return 1
    procd_open_instance
    procd_set_param command /usr/local/bin/vohive-frpc -c /etc/vohive-https/frpc.toml
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
