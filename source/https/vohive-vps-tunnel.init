#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98
STOP=15

start_service() {
    [ -f /etc/vohive-https/ssh-tunnel.key ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/dbclient -T -N -K 20 -I 180 \
        -o BatchMode=yes -o ExitOnForwardFailure=yes \
        -i /etc/vohive-https/ssh-tunnel.key \
        -R 127.0.0.1:17575:127.0.0.1:7575 \
        -L 127.0.0.1:17000:127.0.0.1:17000 \
        ubuntu@129.150.57.185
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
