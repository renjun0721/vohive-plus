#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
start_service() {
    [ -x /usr/local/bin/vohive-plus-run ] || return 1
    [ -f /mnt/sata2-4/vohive-plus/config/config.yaml ] || return 1
    procd_open_instance
    procd_set_param command /usr/local/bin/vohive-plus-run
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 35
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    docker stop --time 25 vohive-plus >/dev/null 2>&1 || true
}
